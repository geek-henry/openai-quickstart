   "cell_type": "markdown",
   "id": "summary_runnable_example",
   "metadata": {},
   "source": [
    "### 在 RunnableWithMessageHistory 中使用摘要缓冲记忆\n",
    "\n",
    "下面演示如何将摘要缓冲记忆集成到完整的对话链中。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "summary_runnable_code",
   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder\n",
    "from langchain_core.runnables.history import RunnableWithMessageHistory\n",
    "\n",
    "# 创建提示模板\n",
    "prompt_summary = ChatPromptTemplate.from_messages([\n",
    "    (\"system\", \"你是一个友好的AI助手，善于交谈并提供详细的信息。\"),\n",
    "    MessagesPlaceholder(variable_name=\"history\"),\n",
    "    (\"human\", \"{input}\")\n",
    "])\n",
    "\n",
    "# 创建链\n",
    "chain_summary = prompt_summary | llm_summary\n",
    "\n",
    "# 创建摘要缓冲记忆存储\n",
    "summary_message_histories = {}\n",
    "\n",
    "def get_summary_message_history(session_id: str):\n",
    "    if session_id not in summary_message_histories:\n",
    "        summary_message_histories[session_id] = SummaryBufferChatMessageHistory(\n",
    "            llm=llm_summary, \n",
    "            max_token_limit=100\n",
    "        )\n",
    "    return summary_message_histories[session_id]\n",
    "\n",
    "# 使用 RunnableWithMessageHistory 包装链\n",
    "conversation_with_summary = RunnableWithMessageHistory(\n",
    "    chain_summary,\n",
    "    get_summary_message_history,\n",
    "    input_messages_key=\"input\",\n",
    "    history_messages_key=\"history\"\n",
    ")\n",
    "\n",
    "print(\"已创建对话链（使用 ConversationSummaryBufferMemory 模式）\")\n",
    "\n",
    "# 进行多轮对话\n",
    "response1 = conversation_with_summary.invoke(\n",
    "    {\"input\": \"你好，请介绍一下你自己\"},\n",
    "    config={\"configurable\": {\"session_id\": \"session3\"}}\n",
    ")\n",
    "print(f\"\\n对话1: {response1.content[:150]}...\")\n",
    "\n",
    "response2 = conversation_with_summary.invoke(\n",
    "    {\"input\": \"你最擅长什么?\"},\n",
    "    config={\"configurable\": {\"session_id\": \"session3\"}}\n",
    ")\n",
    "print(f\"\\n对话2: {response2.content[:150]}...\")\n",
    "\n",
    "# 查看当前记忆状态\n",
    "history = get_summary_message_history(\"session3\")\n",
    "print(f\"\\n\\n当前记忆Token数: {history._get_messages_token_count()}\")\n",
    "print(f\"当前消息数量: {len(history.messages)}\")\n",
    "if history.summary:\n",
    "    print(f\"\\n已生成摘要: {history.summary[:100]}...\")"
   ]
  },
