    "## ConversationBufferWindowMemory 模式\n",
    "\n",
    "`ConversationBufferWindowMemory` 会在时间轴上保留对话的交互列表。它只使用最后 K 次交互。这对于保持最近交互的滑动窗口非常有用，以避免缓冲区过大。\n",
    "\n",
    "我们可以通过自定义 `get_message_history` 函数来实现窗口记忆功能。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dbe61067-5b8f-40a1-827e-4c8c6ad473dd",
   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain_openai import ChatOpenAI\n",
    "from langchain_core.prompts import ChatPromptTemplate, MessagesPlaceholder\n",
    "from langchain_core.runnables.history import RunnableWithMessageHistory\n",
    "from langchain_community.chat_message_histories import ChatMessageHistory\n",
    "\n",
    "# 自定义消息历史类，实现窗口功能\n",
    "class WindowedChatMessageHistory(ChatMessageHistory):\n",
    "    def __init__(self, k: int = 2):\n",
    "        super().__init__()\n",
    "        self.k = k  # 保留最近 k 次交互（即 2k 条消息：k个human + k个AI）\n",
    "    \n",
    "    @property\n",
    "    def messages(self):\n",
    "        # 只返回最近的 2k 条消息（k次交互）\n",
    "        return self._messages[-(self.k * 2):] if len(self._messages) > self.k * 2 else self._messages\n",
    "    \n",
    "    @messages.setter\n",
    "    def messages(self, value):\n",
    "        self._messages = value\n",
    "\n",
    "# 初始化语言模型\n",
    "llm_window = ChatOpenAI(temperature=0, max_tokens=1000)\n",
    "\n",
    "# 创建提示模板\n",
    "prompt_window = ChatPromptTemplate.from_messages([\n",
    "    (\"system\", \"你是一个友好的AI助手，善于交谈并提供详细的信息。如果你不知道问题的答案，你会诚实地说不知道。\"),\n",
    "    MessagesPlaceholder(variable_name=\"history\"),\n",
    "    (\"human\", \"{input}\")\n",
    "])\n",
    "\n",
    "# 创建链\n",
    "chain_window = prompt_window | llm_window\n",
    "\n",
    "# 创建带窗口的消息历史存储\n",
    "window_message_histories = {}\n",
    "\n",
    "def get_window_message_history(session_id: str):\n",
    "    if session_id not in window_message_histories:\n",
    "        window_message_histories[session_id] = WindowedChatMessageHistory(k=2)  # 只保留最近2次交互\n",
    "    return window_message_histories[session_id]\n",
    "\n",
    "# 使用 RunnableWithMessageHistory 包装链\n",
    "conversation_with_window = RunnableWithMessageHistory(\n",
    "    chain_window,\n",
    "    get_window_message_history,\n",
    "    input_messages_key=\"input\",\n",
    "    history_messages_key=\"history\"\n",
    ")\n",
    "\n",
    "print(\"已创建对话链（使用 ConversationBufferWindowMemory 模式 - 只保留最近2次交互）\")\n",
    "\n",
    "# 第一轮对话\n",
    "response1 = conversation_with_window.invoke(\n",
    "    {\"input\": \"嗨，你最近过得怎么样？\"},\n",
    "    config={\"configurable\": {\"session_id\": \"session2\"}}\n",
    ")\n",
    "print(f\"\\n第1轮: {response1.content}\")"
   ]
  },
