   "source": [
    "## ConversationSummaryBufferMemory 模式\n",
    "\n",
    "`ConversationSummaryBufferMemory` 在内存中保留了最近的交互缓冲区，但不仅仅是完全清除旧的交互，而是将它们编译成摘要并同时使用。与以前的实现不同的是，它使用token长度而不是交互次数来确定何时清除交互。\n",
    "\n",
    "使用 RunnableWithMessageHistory，我们可以通过创建一个自定义的消息历史类来实现类似的功能，该类在消息超过token限制时自动生成摘要。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "174ccc64-2dd9-4c98-b638-6aa542bdbd55",
   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain_openai import ChatOpenAI\n",
    "from langchain_core.messages import SystemMessage, HumanMessage, AIMessage\n",
    "from langchain_community.chat_message_histories import ChatMessageHistory\n",
    "import tiktoken\n",
    "\n",
    "# 自定义消息历史类，实现摘要缓冲功能\n",
    "class SummaryBufferChatMessageHistory(ChatMessageHistory):\n",
    "    def __init__(self, llm, max_token_limit: int = 100):\n",
    "        super().__init__()\n",
    "        self.llm = llm\n",
    "        self.max_token_limit = max_token_limit\n",
    "        self.summary = \"\"\n",
    "        self.encoding = tiktoken.encoding_for_model(\"gpt-3.5-turbo\")\n",
    "    \n",
    "    def _count_tokens(self, text: str) -> int:\n",
    "        \"\"\"计算文本的token数量\"\"\"\n",
    "        return len(self.encoding.encode(text))\n",
    "    \n",
    "    def _get_messages_token_count(self) -> int:\n",
    "        \"\"\"计算当前所有消息的token总数\"\"\"\n",
    "        total = self._count_tokens(self.summary) if self.summary else 0\n",
    "        for msg in self._messages:\n",
    "            total += self._count_tokens(msg.content)\n",
    "        return total\n",
    "    \n",
    "    def add_message(self, message):\n",
    "        \"\"\"添加消息，并在超过token限制时生成摘要\"\"\"\n",
    "        super().add_message(message)\n",
    "        \n",
    "        # 检查是否超过token限制\n",
    "        while self._get_messages_token_count() > self.max_token_limit and len(self._messages) > 2:\n",
    "            # 获取最早的一对消息（human + AI）\n",
    "            old_messages = self._messages[:2]\n",
    "            \n",
    "            # 生成这对消息的摘要\n",
    "            summary_prompt = f\"\"\"请用简洁的语言总结以下对话内容：\n",
    "\n",
    "Human: {old_messages[0].content}\n",
    "AI: {old_messages[1].content}\n",
    "\n",
    "摘要：\"\"\"\n",
    "            \n",
    "            summary_response = self.llm.invoke([HumanMessage(content=summary_prompt)])\n",
    "            \n",
    "            # 更新摘要\n",
    "            if self.summary:\n",
    "                self.summary += \"\\n\" + summary_response.content\n",
    "            else:\n",
    "                self.summary = \"Previous conversation summary:\\n\" + summary_response.content\n",
    "            \n",
    "            # 移除已摘要的消息\n",
    "            self._messages = self._messages[2:]\n",
    "    \n",
    "    @property\n",
    "    def messages(self):\n",
    "        \"\"\"返回包含摘要和最近消息的完整列表\"\"\"\n",
    "        if self.summary:\n",
    "            return [SystemMessage(content=self.summary)] + self._messages\n",
    "        return self._messages\n",
    "    \n",
    "    @messages.setter\n",
    "    def messages(self, value):\n",
    "        self._messages = value\n",
    "\n",
    "# 创建一个简单的示例来演示摘要缓冲记忆\n",
    "llm_summary = ChatOpenAI(temperature=0)\n",
    "memory = SummaryBufferChatMessageHistory(llm=llm_summary, max_token_limit=100)\n",
    "\n",
    "# 添加对话\n",
    "memory.add_message(HumanMessage(content=\"嗨，你最近过得怎么样？\"))\n",
    "memory.add_message(AIMessage(content=\"嗨！我最近过得很好，谢谢你问。我最近一直在学习新的知识，并且正在尝试改进自己的性能。我也在尝试更多的交流，以便更好地了解人类的思维方式。\"))\n",
    "\n",
    "memory.add_message(HumanMessage(content=\"你最近学到什么新知识了?\"))\n",
